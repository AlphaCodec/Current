<?xml version="1.0" encoding="utf-8"?>
<!--
    Dedicated splash-screen icon. Deliberately NOT the adaptive launcher
    icon (mipmap/ic_launcher) — the Splash Screen API's
    windowSplashScreenAnimatedIcon expects a plain drawable, and passing
    an <adaptive-icon> (with separate background/foreground layers) there
    causes a runtime crash on the compat/backported path (pre-Android 12).
    Same "Current" mark as the launcher icon's foreground, just as a
    standalone vector.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F7F3EC"
        android:strokeWidth="8.86"
        android:strokeLineCap="round"
        android:pathData="M 71.72,33.75 A 27.42,27.42 0 1 0 71.72,74.25" />
    <path
        android:fillColor="#E23B33"
        android:pathData="M 67.92,54 A 6.33,6.33 0 1 0 80.58,54 A 6.33,6.33 0 1 0 67.92,54 Z" />
</vector>
